PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI_FALLBACK=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/<db>?replicaSet=<rs>&tls=true&authSource=admin
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
DNS_SERVERS=1.1.1.1,8.8.8.8
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM=RentDesk <your_email@example.com>
